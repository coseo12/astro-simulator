{
  "name": "@astro-simulator/shared",
  "version": "0.18.0",
  "private": true,
  "description": "Shared types, constants, and event definitions for astro-simulator",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.js"
    },
    "./data/solar-system.json": "./data/solar-system.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm run verify:emit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist .tsbuildinfo *.tsbuildinfo",
    "verify:emit": "test -f dist/index.js || { echo '[verify:emit] @astro-simulator/shared: dist/index.js 가 없다. tsc 가 exit 0 인 채 아무것도 emit 하지 않았다 (stale tsbuildinfo 의심). pnpm --filter @astro-simulator/shared clean 후 재빌드하라.' >&2; exit 1; }",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "sideEffects": false
}
