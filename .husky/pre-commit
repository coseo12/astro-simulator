#!/usr/bin/env bash

# U+FFFD 인코딩 검사 (CRITICAL DIRECTIVE #4)
./scripts/check-encoding.sh

# P6-E #193 (E4) — 신규 함수 중복 방지 가드 (warn-only)
# ADR: docs/decisions/20260417-duplicate-function-guard.md
# 실패해도 커밋 차단 안 함 (|| true). WARN 출력만.
node scripts/check-duplicate-functions.mjs --staged || true

# lint-staged 실행 (변경된 파일만 lint + format)
pnpm lint-staged

# #982 — prettier 소유 markdown 의 bare `~~` 금지 (ADR 20260814-982-changelog-tilde-guard.md)
# **반드시 lint-staged 다음 줄**이다. 손상을 만드는 주체가 위 줄의 `prettier --write` 이므로
# (인라인 코드 밖 단일 `~` → GFM 취소선 정규화), 그 직후가 가장 이른 검출 지점이다.
# `|| true` 없음 — fail-fast (CLAUDE.md §가드 설계 원칙).
node scripts/verify-md-tilde.mjs --staged

# #1103 — 머지 충돌 마커 금지 (ADR 20260817-1103-conflict-marker-guard.md)
# 위 `~~` 가드와 **같은 자리에 같은 이유로** 둔다: 손상을 만드는 주체가 lint-staged 의
# `prettier --write` 다. 마커를 md 문법으로 정규화해 (`sep` 은 백슬래시 escape, `close` 는
# blockquote) 커밋 전 육안·grep 검사의 형태와 커밋물의 형태가 갈린다.
# ⚠️ 저쪽과 달리 **전수**다 — 충돌 마커에는 "고칠 수 없는 존량" 범주가 없어 diff 로 좁힐
# 이유가 없다 (전수 745 파일 0.4초). `|| true` 없음 — fail-fast.
node scripts/verify-md-conflict-marker.mjs
